---
const pathname = Astro.url.pathname;
const centerLinks = [
  { href: '/buy', label: 'Buy a Business' },
  { href: '/grow', label: 'Grow Your Business' },
  { href: '/speaking', label: 'Speaking' },
  { href: '/about', label: 'About' },
];
function active(href: string) {
  return pathname === href || pathname.startsWith(href + '/');
}
---
<header class="relative z-20 border-b border-border/60 bg-[#f9f8f4]/90 backdrop-blur supports-[backdrop-filter]:bg-[#f9f8f4]/80">
  <div class="site-width grid grid-cols-[1fr_auto] items-center gap-4 py-6 md:grid-cols-[1fr_auto_1fr]">
    <a href="/" class="justify-self-start text-sm font-bold tracking-[0.08em] text-navy hover:text-navy/70 sm:text-base">
      BRIAN BEERS
    </a>

    <nav class="hidden items-center justify-center gap-8 md:flex lg:gap-10" aria-label="Primary">
      {centerLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'whitespace-nowrap text-sm font-medium hover:text-navy',
            active(link.href) ? 'text-navy' : 'text-navy/55',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden justify-self-end md:block">
      <a
        href="/contact"
        class:list={[
          'text-sm font-medium hover:text-navy',
          active('/contact') ? 'text-navy' : 'text-navy/55',
        ]}
      >
        Contact
      </a>
    </div>

    <details class="relative justify-self-end md:hidden">
      <summary class="cursor-pointer list-none rounded-md border border-border bg-white px-3 py-1.5 text-sm font-medium text-navy">
        Menu
      </summary>
      <div class="absolute right-0 z-50 mt-2 w-56 rounded-xl border border-border bg-white p-2 shadow-lg">
        {centerLinks.map((link) => (
          <a href={link.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-cream-soft">
            {link.label}
          </a>
        ))}
        <a href="/contact" class="block rounded-lg px-3 py-2 text-sm font-medium text-navy hover:bg-cream-soft">
          Contact
        </a>
      </div>
    </details>
  </div>
</header>
