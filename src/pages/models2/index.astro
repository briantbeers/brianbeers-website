---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const categoryLabel: Record<string, string> = {
  'home-services': 'Home Services',
  'retail-resale': 'Retail',
  auto: 'Automotive',
  'business-services': 'B2B',
  'real-estate-ops': 'Real Estate',
  education: 'Education',
  'senior-care': 'Senior Care',
  'food-hospitality': 'Food & Hospitality',
  'health-wellness': 'Health & Wellness',
  other: 'Other',
};

/** Preferred display order when counts tie. */
const categoryDisplayOrder = [
  'home-services',
  'business-services',
  'health-wellness',
  'food-hospitality',
  'retail-resale',
  'senior-care',
  'auto',
  'real-estate-ops',
  'education',
  'other',
];

/** Within home-services, nudge high-volume models slightly first. */
const homeServicesPriority = [
  'roofing',
  'hvac',
  'residential-plumbing',
  'electrical',
  'lawn-landscaping',
  'junk-removal',
  'residential-cleaning',
  'handyman',
  'residential-painting',
  'pest-control',
  'auto-repair',
];

/** Business-type tags only (defense in depth). */
const ALLOWED_TAGS = new Set([
  "recurring-revenue",
  "easy-entry",
  "seasonal",
  "high-ticket",
  "project-based",
  "route-based",
  "insurance-driven",
  "emergency",
  "membership",
  "b2b",
]);

const TAG_LABELS: Record<string, string> = {
  "recurring-revenue": "Recurring Revenue",
  "easy-entry": "Easy Entry",
  seasonal: "Seasonal",
  "high-ticket": "High Ticket",
  "project-based": "Project Based",
  "route-based": "Route Based",
  "insurance-driven": "Insurance Driven",
  emergency: "Emergency",
  membership: "Membership",
  b2b: "B2B",
};

const categoryIntros: Record<string, string> = {
  'home-services':
    'Home services sit close to essential demand — roofs leak, systems fail, yards grow. Many models mix recurring maintenance with emergency calls, and density in a local market often matters more than flashy branding. The interesting ownership question is how much stays owner-operator versus how much can be leveraged with crews, dispatch, and process.',
  'retail-resale':
    'Retail and resale businesses live on inventory turns, assortment, and foot traffic (or a strong buy-sell engine). The work is merchandising, sourcing, and knowing what moves in your market — not abstract growth theory. Soft ownership here usually means learning the buy curve and the floor before scaling square footage.',
  auto:
    'Cars break. That simple fact keeps automotive work on the essential-spend list. Bay utilization, technician capacity, and parts flow usually matter more than “people need cars.” Educational browsing here is about how the shop day actually runs — not promises about outcomes.',
  'business-services':
    'B2B services often sell in daylight hours to accounts that renew or expand when trust is earned. Contracts, recurring relationships, and clear delivery scopes tend to define the model. The ownership lens is usually process and people — how work is sold, staffed, and delivered consistently.',
  'real-estate-ops':
    'Real estate ops models often revolve around doors under management, transitions, and adjacent services as demographics shift. The interesting part is operational rhythm: turnovers, vendors, communication, and trust with owners or residents — not speculation about property values.',
  education:
    'Education businesses lean on enrollment, tuition cadence, and the labor of teachers or coaches who carry the reputation. Local trust and outcomes for families usually matter more than ads. Soft ownership questions include capacity, staffing depth, and how the program holds quality as it grows.',
  'senior-care':
    'Senior care sits next to long demographic trends and deep trust requirements. Many models are built around recurring care hours, family communication, and compliance with how care is delivered. Educational framing here is about the work and the relationships — never earnings claims.',
  'food-hospitality':
    'Food and hospitality businesses run on dayparts, labor, and site selection. The floor tells the truth faster than a spreadsheet: rush periods, waste, and guest experience. Ownership education usually starts with how the day actually flows before anyone talks about expansion.',
  'health-wellness':
    'Health and wellness models often mix memberships, retention, and — where clinical — regulated nuance. Recurring visits and trusted practitioners tend to matter more than one-time transactions. Browse for fit: how clients return, how staff is scheduled, and what the experience must protect.',
  other:
    'This catch-all covers models that do not sit cleanly in one industry bucket. Treat it as a browsing lane for adjacent or hybrid ideas — still educational structure only, with the same soft ownership tone and no earnings promises.',
};

const categoryCover: Record<string, string> = {
  'home-services': '/models/covers/home-services.jpg',
  'retail-resale': '/models/covers/retail-resale.jpg',
  auto: '/models/covers/auto.jpg',
  'business-services': '/models/covers/business-services.jpg',
  'real-estate-ops': '/models/covers/real-estate-ops.jpg',
  education: '/models/covers/education.jpg',
  'senior-care': '/models/covers/senior-care.jpg',
  'food-hospitality': '/models/covers/food-hospitality.jpg',
  'health-wellness': '/models/covers/health-wellness.jpg',
  other: '/models/covers/other.jpg',
};

/** Optional slug-specific cover overrides for layout testing. */
const slugCoverOverrides: Record<string, string> = {
  'used-clothing-resale': '/models/used-clothing/racks-1.jpg',
  'kids-clothing-resale': '/models/used-clothing/racks-2.jpg',
};

function modelPath(model: { data: { slug?: string }; id: string }) {
  return model.data.slug ?? model.id.replace(/\.(md|mdx|mdoc)$/, '');
}

function priorityIndex(slug: string) {
  const i = homeServicesPriority.indexOf(slug);
  return i === -1 ? homeServicesPriority.length : i;
}

/** Build-time inventory of per-slug covers (public/ is not Vite-importable). */
const categoryCoverSlugs = new Set(Object.keys(categoryCover));
const coversDir = path.join(process.cwd(), 'public/models/covers');
const slugCoverSet = new Set(
  (fs.existsSync(coversDir) ? fs.readdirSync(coversDir) : [])
    .filter((f) => /\.jpe?g$/i.test(f))
    .map((f) => f.replace(/\.jpe?g$/i, ''))
    .filter((s) => s && !categoryCoverSlugs.has(s))
);

function coverFor(slug: string, category: string) {
  // Keep used-clothing rack overrides when those files are configured.
  if (slugCoverOverrides[slug]) return slugCoverOverrides[slug];
  if (slugCoverSet.has(slug)) return `/models/covers/${slug}.jpg`;
  return categoryCover[category] ?? categoryCover.other;
}

const allPublished = (await getCollection('models')).filter(
  (m) => m.data.publish && (m.data.status === 'ready' || m.data.status === 'published')
);

const categoryCounts = new Map<string, number>();
for (const m of allPublished) {
  categoryCounts.set(m.data.category, (categoryCounts.get(m.data.category) ?? 0) + 1);
}

const categoriesByCount = [...categoryCounts.entries()].sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  const ai = categoryDisplayOrder.indexOf(a[0]);
  const bi = categoryDisplayOrder.indexOf(b[0]);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});

const models = [...allPublished].sort((a, b) => {
  const ca = categoryCounts.get(a.data.category) ?? 0;
  const cb = categoryCounts.get(b.data.category) ?? 0;
  if (cb !== ca) return cb - ca;
  const ai = categoryDisplayOrder.indexOf(a.data.category);
  const bi = categoryDisplayOrder.indexOf(b.data.category);
  if (ai !== bi) return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
  if (a.data.category === 'home-services' && b.data.category === 'home-services') {
    const pa = priorityIndex(modelPath(a));
    const pb = priorityIndex(modelPath(b));
    if (pa !== pb) return pa - pb;
  }
  return a.data.title.localeCompare(b.data.title);
});

const tagFreq = new Map<string, number>();
for (const m of allPublished) {
  for (const t of m.data.tags ?? []) {
    const key = t.trim().toLowerCase();
    if (!key || !ALLOWED_TAGS.has(key)) continue;
    tagFreq.set(key, (tagFreq.get(key) ?? 0) + 1);
  }
}

const popularTags = [...tagFreq.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag, count]) => ({ tag, count }));

const total = models.length;
const knownCategoryValues = categoriesByCount.map(([cat]) => cat);
const knownTagValues = popularTags.map((t) => t.tag);

function formatTag(tag: string) {
  return (
    TAG_LABELS[tag] ??
    tag
      .split(/[-_/]/)
      .filter(Boolean)
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ')
  );
}
---
<BaseLayout
  title="Business models (layout test) — Brian Beers"
  description="Layout test for model cards with covers and category intros — educational browsing only."
>
  <section class="section !pt-12 !pb-16">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Models2 · Layout test</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-navy sm:text-5xl">Business models</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-navy/75 sm:text-lg">
      Educational sample guides for browsing. Not offers, not earnings claims — clear structure so you can
      compare fit and how the work actually flows.
    </p>
    <p class="mt-2 text-xs text-navy/40">
      Parallel layout test (covers + category intros). Production list remains at
      <a href="/models" class="underline hover:text-navy">/models</a>.
    </p>

    <div
      id="models-filters"
      class="sticky top-0 z-20 -mx-4 mt-8 border-y border-border bg-cream/95 px-4 py-3 backdrop-blur-sm sm:-mx-6 sm:px-6 lg:-mx-8 lg:px-8"
      data-known-categories={knownCategoryValues.join(',')}
      data-known-tags={knownTagValues.join(',')}
    >
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by category">
        <button
          type="button"
          class="filter-chip is-active"
          data-filter-type="all"
          data-filter-value="all"
          aria-pressed="true"
        >
          All <span class="chip-count">({total})</span>
        </button>
        {categoriesByCount.map(([cat, count]) => (
          <button
            type="button"
            class="filter-chip"
            data-filter-type="category"
            data-filter-value={cat}
            aria-pressed="false"
          >
            {categoryLabel[cat] ?? cat} <span class="chip-count">({count})</span>
          </button>
        ))}
      </div>

      {popularTags.length > 0 && (
        <div class="mt-2.5 flex flex-wrap items-center gap-1.5" role="group" aria-label="Refine by tag">
          <span class="mr-1 text-[11px] font-medium uppercase tracking-wider text-navy/40">Tags</span>
          {popularTags.map(({ tag, count }) => (
            <button
              type="button"
              class="tag-chip"
              data-filter-type="tag"
              data-filter-value={tag}
              aria-pressed="false"
            >
              {formatTag(tag)} <span class="opacity-50">({count})</span>
            </button>
          ))}
        </div>
      )}

      <p class="mt-2.5 text-xs text-navy/50">
        Showing <span id="showing-count" class="font-semibold text-navy/70">{total}</span> of {total}
        <span id="filter-hint" class="hidden text-navy/40">
          {' '}· <button type="button" id="clear-filters" class="underline hover:text-navy">Clear filters</button>
        </span>
      </p>
    </div>

    <div
      id="category-intro"
      class="mt-5 hidden rounded-2xl border border-border bg-white/80 px-5 py-4 shadow-sm"
      aria-live="polite"
    >
      <p id="category-intro-label" class="text-[11px] font-semibold uppercase tracking-wider text-accent"></p>
      <p id="category-intro-body" class="mt-1.5 text-sm leading-relaxed text-navy/70"></p>
    </div>

    <div id="models-grid" class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {models.map((model) => {
        const slug = modelPath(model);
        const tags = (model.data.tags ?? [])
          .map((t) => t.trim().toLowerCase())
          .filter((t) => t && ALLOWED_TAGS.has(t));
        const desc = model.data.description.replace(/\s+/g, ' ').trim();
        const shortDesc = desc.length > 90 ? desc.slice(0, 87).replace(/\s+\S*$/, '') + '…' : desc;
        const cover = coverFor(slug, model.data.category);
        return (
          <a
            href={`/models/${slug}`}
            class="model-card group flex flex-col overflow-hidden rounded-xl border border-border bg-white shadow-sm transition hover:border-accent/40 hover:shadow-md"
            data-category={model.data.category}
            data-tags={tags.join(' ')}
            data-slug={slug}
          >
            <div class="aspect-[16/10] overflow-hidden bg-cream-deep/40">
              <img
                src={cover}
                alt=""
                class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                loading="lazy"
                width="640"
                height="400"
              />
            </div>
            <div class="flex flex-1 flex-col px-4 py-3.5">
              <p class="text-[10px] font-semibold uppercase tracking-wider text-navy/45">
                {categoryLabel[model.data.category] ?? model.data.category}
              </p>
              <h2 class="mt-1 text-[15px] font-bold leading-snug text-navy group-hover:text-navy-soft">
                {model.data.title}
              </h2>
              <p class="mt-1 line-clamp-1 text-xs leading-relaxed text-navy/55">{shortDesc}</p>
            </div>
          </a>
        );
      })}
    </div>

    <p id="empty-state" class="mt-10 hidden text-center text-sm text-navy/55">
      No models match these filters.
      <button type="button" class="ml-1 font-semibold text-navy underline hover:text-accent" data-clear>
        Show all
      </button>
    </p>

    <div class="mt-12 rounded-2xl border border-border bg-slate-50/60 p-6 sm:p-8">
      <p class="text-sm font-semibold text-navy">Part of the Buy journey</p>
      <p class="mt-2 text-sm leading-relaxed text-navy/65">
        These samples live under Buy. Exploring franchises too?
        <a href="/franchises" class="font-semibold text-navy hover:text-accent">Visit the franchise hub</a>
        or
        <a href="/buy" class="font-semibold text-navy hover:text-accent">return to Buy</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-chip {
    @apply inline-flex shrink-0 items-center rounded-full border border-border bg-white px-3 py-1.5 text-xs font-semibold text-navy/75 transition hover:border-navy/25 hover:bg-cream-soft;
  }
  .filter-chip.is-active {
    @apply border-navy bg-navy text-white hover:border-navy hover:bg-navy;
  }
  .filter-chip .chip-count {
    @apply ml-1 font-medium opacity-70;
  }
  .tag-chip {
    @apply inline-flex shrink-0 items-center rounded-full border border-transparent bg-cream-deep/50 px-2.5 py-1 text-[11px] font-medium text-navy/65 transition hover:border-border hover:bg-white;
  }
  .tag-chip.is-active {
    @apply border-accent bg-accent/15 text-navy;
  }
  .model-card.is-hidden {
    display: none;
  }
</style>

<script define:vars={{ categoryIntros, categoryLabel }}>
  const filterBar = document.getElementById('models-filters');
  const showingEl = document.getElementById('showing-count');
  const hintEl = document.getElementById('filter-hint');
  const emptyEl = document.getElementById('empty-state');
  const clearBtn = document.getElementById('clear-filters');
  const categoryChips = document.querySelectorAll('.filter-chip');
  const tagChips = document.querySelectorAll('.tag-chip');
  const introEl = document.getElementById('category-intro');
  const introLabel = document.getElementById('category-intro-label');
  const introBody = document.getElementById('category-intro-body');

  const knownCategories = (filterBar?.dataset.knownCategories || '').split(',').filter(Boolean);
  const knownTags = (filterBar?.dataset.knownTags || '').split(',').filter(Boolean);

  let activeCategory = null;
  let activeTag = null;

  function cards() {
    return Array.from(document.querySelectorAll('.model-card'));
  }

  function setPressed(el, on) {
    el.classList.toggle('is-active', on);
    el.setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  function syncChipUI() {
    categoryChips.forEach((chip) => {
      const type = chip.dataset.filterType;
      const value = chip.dataset.filterValue || '';
      if (type === 'all') setPressed(chip, !activeCategory && !activeTag);
      else setPressed(chip, activeCategory === value);
    });
    tagChips.forEach((chip) => {
      setPressed(chip, activeTag === (chip.dataset.filterValue || ''));
    });
  }

  function syncIntro() {
    if (!introEl || !introLabel || !introBody) return;
    if (activeCategory && categoryIntros[activeCategory]) {
      introLabel.textContent = categoryLabel[activeCategory] ?? activeCategory;
      introBody.textContent = categoryIntros[activeCategory];
      introEl.classList.remove('hidden');
    } else {
      introEl.classList.add('hidden');
      introLabel.textContent = '';
      introBody.textContent = '';
    }
  }

  function updateUrl() {
    const params = new URLSearchParams();
    if (activeCategory) params.set('category', activeCategory);
    if (activeTag) params.set('tag', activeTag);
    const qs = params.toString();
    const next = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
    history.replaceState(null, '', next);
  }

  function applyFilters() {
    let visible = 0;
    for (const card of cards()) {
      const cat = card.dataset.category || '';
      const tags = (card.dataset.tags || '').split(/\s+/).filter(Boolean);
      const catOk = !activeCategory || cat === activeCategory;
      const tagOk = !activeTag || tags.includes(activeTag);
      const show = catOk && tagOk;
      card.classList.toggle('is-hidden', !show);
      if (show) visible++;
    }
    if (showingEl) showingEl.textContent = String(visible);
    const filtered = !!(activeCategory || activeTag);
    hintEl?.classList.toggle('hidden', !filtered);
    emptyEl?.classList.toggle('hidden', visible > 0);
    syncChipUI();
    syncIntro();
    updateUrl();
  }

  function clearFilters() {
    activeCategory = null;
    activeTag = null;
    applyFilters();
  }

  categoryChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const type = chip.dataset.filterType;
      const value = chip.dataset.filterValue || '';
      if (type === 'all') {
        clearFilters();
        return;
      }
      activeCategory = activeCategory === value ? null : value;
      applyFilters();
    });
  });

  tagChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const value = chip.dataset.filterValue || '';
      activeTag = activeTag === value ? null : value;
      applyFilters();
    });
  });

  clearBtn?.addEventListener('click', clearFilters);
  emptyEl?.querySelector('[data-clear]')?.addEventListener('click', clearFilters);

  const params = new URLSearchParams(window.location.search);
  const qCat = params.get('category');
  const qTag = params.get('tag');
  if (qCat && knownCategories.includes(qCat)) activeCategory = qCat;
  if (qTag && knownTags.includes(qTag)) activeTag = qTag;

  if (activeCategory || activeTag) applyFilters();
  else {
    syncChipUI();
    syncIntro();
  }
</script>
