---
import BaseLayout from '../layouts/BaseLayout.astro';

const DEFAULT_CONTACT_ENDPOINT =
  'https://script.google.com/macros/s/AKfycbYF4Cf_SVqf2PsD7EtsjuccxpfV_dtoaMX2Pq1V0vozXZS6wNF0g8FSxsnbjQGHpsga/exec';

const envEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT;
const contactEndpoint = envEndpoint || DEFAULT_CONTACT_ENDPOINT;
---
<BaseLayout
  title="Contact — Brian Beers"
  description="Contact Brian Beers."
>
  <section class="section max-w-2xl">
    <h1 id="contact-heading" class="text-4xl font-bold tracking-tight text-navy">
      Contact me
    </h1>

    <div
      id="contact-success"
      class="card mt-10 hidden border-accent/40 bg-cream-soft"
      role="status"
      aria-live="polite"
    >
      <p id="contact-success-title" class="text-lg font-semibold text-navy">Message received.</p>
    </div>

    <p
      id="contact-error"
      class="mt-6 hidden rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"
      role="alert"
      aria-live="assertive"
    ></p>

    <form
      class="card mt-10 space-y-5"
      method="post"
      action={contactEndpoint}
      id="contact-form"
      novalidate
    >
      {/* Honeypot — leave empty; bots that fill it are ignored by Apps Script */}
      <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden opacity-0" aria-hidden="true">
        <label for="_honey">Website</label>
        <input id="_honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-navy">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy placeholder:text-navy/35 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-navy">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy placeholder:text-navy/35 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="interest" class="block text-sm font-medium text-navy">I’m interested in</label>
        <select
          id="interest"
          name="interest"
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
        >
          <option value="guide">The Copy-Paste Millionaire free guide</option>
          <option value="buy" selected>Buying a business</option>
          <option value="grow">Growing my business</option>
          <option value="unsure">Not sure yet</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-navy">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy placeholder:text-navy/35 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="A bit about where you are and what you’re figuring out…"
        ></textarea>
      </div>
      <div id="intent-slot"></div>
      <button id="contact-submit" type="submit" class="btn-primary w-full sm:w-auto">
        Send message
      </button>
      <p class="text-xs leading-relaxed text-navy/50">No spam.</p>
    </form>
  </section>

  <script define:vars={{ contactEndpoint }}>
    const INTEREST_LABELS = {
      guide: 'The Copy-Paste Millionaire free guide',
      buy: 'Buying a business',
      grow: 'Growing my business',
      unsure: 'Not sure yet',
    };

    const params = new URLSearchParams(window.location.search);
    const email = params.get('email') || '';
    const isGuide = params.get('intent') === 'guide';
    const sent = params.get('sent') === '1';

    const emailInput = document.getElementById('email');
    const interest = document.getElementById('interest');
    const message = document.getElementById('message');
    const heading = document.getElementById('contact-heading');
    const submit = document.getElementById('contact-submit');
    const intentSlot = document.getElementById('intent-slot');
    const form = document.getElementById('contact-form');
    const successEl = document.getElementById('contact-success');
    const successTitle = document.getElementById('contact-success-title');
    const errorEl = document.getElementById('contact-error');

    const defaultSubmitLabel = submit?.textContent || 'Send message';

    function setLoading(loading) {
      if (!(submit instanceof HTMLButtonElement)) return;
      submit.disabled = loading;
      submit.classList.toggle('opacity-70', loading);
      submit.classList.toggle('cursor-wait', loading);
      submit.textContent = loading
        ? 'Sending…'
        : isGuide
          ? 'Request the guide'
          : defaultSubmitLabel;
    }

    function showSuccess() {
      form?.classList.add('hidden');
      errorEl?.classList.add('hidden');
      successEl?.classList.remove('hidden');
    }

    function showError(msg) {
      if (!(errorEl instanceof HTMLElement)) return;
      errorEl.textContent = msg || 'Something went wrong. Please try again.';
      errorEl.classList.remove('hidden');
    }

    if (email && emailInput instanceof HTMLInputElement) {
      emailInput.value = email;
    }

    if (isGuide) {
      if (heading) heading.textContent = 'Get the free guide';
      if (interest instanceof HTMLSelectElement) interest.value = 'guide';
      if (message instanceof HTMLTextAreaElement && !message.value) {
        message.value = 'Please send The Copy-Paste Millionaire free guide when it is ready.';
      }
      if (submit) submit.textContent = 'Request the guide';
      if (intentSlot) {
        intentSlot.innerHTML = '<input type="hidden" name="intent" value="guide" />';
      }
      if (successTitle) {
        successTitle.textContent = 'Thanks — we’ll send the guide soon.';
      }
    }

    // Deep link / bookmark support for ?sent=1
    if (sent) {
      showSuccess();
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      errorEl?.classList.add('hidden');

      const fd = new FormData(form);
      const interestValue = String(fd.get('interest') || 'unsure');
      const intentValue = String(fd.get('intent') || (isGuide ? 'guide' : ''));
      const interestLabel = INTEREST_LABELS[interestValue] || interestValue;
      const honey = String(fd.get('_honey') || '');

      let subject = `[brianbeers.com] Contact — ${interestLabel}`;
      if (intentValue === 'guide' || interestValue === 'guide') {
        subject = `[brianbeers.com] Free guide request — ${interestLabel}`;
      }

      const payload = {
        name: String(fd.get('name') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        interest: interestValue,
        interest_label: interestLabel,
        message: String(fd.get('message') || '').trim(),
        intent: intentValue,
        page: window.location.href,
        user_agent: navigator.userAgent || '',
        _honey: honey,
        _subject: subject,
      };

      setLoading(true);

      try {
        // text/plain avoids CORS preflight; Apps Script still reads e.postData.contents
        const response = await fetch(contactEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });

        let ok = response.ok;
        try {
          const data = await response.json();
          if (data && (data.success === true || data.ok === true)) {
            ok = true;
          } else if (data && (data.success === false || data.ok === false)) {
            ok = false;
            showError(data.message || 'Something went wrong. Please try again.');
            setLoading(false);
            return;
          }
        } catch {
          // Opaque / redirect / non-JSON — treat HTTP success as success
        }

        if (ok) {
          showSuccess();
          try {
            const next = new URL(window.location.href);
            next.searchParams.set('sent', '1');
            if (intentValue === 'guide' || isGuide) {
              next.searchParams.set('intent', 'guide');
            }
            window.history.replaceState({}, '', next.toString());
          } catch {
            // ignore history failures
          }
        } else {
          showError('Something went wrong. Please try again.');
          setLoading(false);
        }
      } catch {
        showError('Something went wrong. Please try again.');
        setLoading(false);
      }
    });
  </script>
</BaseLayout>
