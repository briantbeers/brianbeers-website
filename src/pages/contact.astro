---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactEndpoint =
  import.meta.env.PUBLIC_CONTACT_ENDPOINT ||
  'https://formsubmit.co/ajax/support@beerspodcast.com';
---
<BaseLayout
  title="Contact — Brian Beers"
  description="Reach out to Brian Beers — soft CTA, educational conversation only."
>
  <section class="section max-w-2xl">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Contact</p>
    <h1 id="contact-heading" class="mt-2 text-4xl font-bold tracking-tight text-navy">
      Let’s talk
    </h1>
    <p id="contact-lead" class="mt-4 text-lg leading-relaxed text-navy/75">
      Share where you are and what you’re figuring out. Soft CTA only — no pitch dump, no earnings promises.
    </p>

    <div
      id="contact-success"
      class="card mt-10 hidden border-accent/40 bg-cream-soft"
      role="status"
      aria-live="polite"
    >
      <p class="text-lg font-semibold text-navy">Thanks — message sent.</p>
      <p id="contact-success-detail" class="mt-2 text-navy/75">
        We’ll get back to you soon. Educational conversation only — not financial advice.
      </p>
    </div>

    <form
      class="card mt-10 space-y-5"
      method="post"
      action={contactEndpoint}
      id="contact-form"
      novalidate
    >
      <div
        id="contact-error"
        class="hidden rounded-lg border border-red-300 bg-red-50 px-3 py-2.5 text-sm text-red-800"
        role="alert"
        aria-live="assertive"
      >
        Something went wrong sending your message. Please try again in a moment, or email
        support@beerspodcast.com.
      </div>

      {/* Honeypot — leave empty; bots that fill it are ignored by Formsubmit / Apps Script */}
      <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden opacity-0" aria-hidden="true">
        <label for="_honey">Website</label>
        <input id="_honey" type="text" name="_honey" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-navy">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy placeholder:text-navy/35 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="Your name"
        />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-navy">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy placeholder:text-navy/35 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="you@example.com"
        />
      </div>
      <div>
        <label for="interest" class="block text-sm font-medium text-navy">I’m interested in</label>
        <select
          id="interest"
          name="interest"
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
        >
          <option value="guide">The Copy-Paste Millionaire free guide</option>
          <option value="buy" selected>Buying a business</option>
          <option value="grow">Growing my business</option>
          <option value="unsure">Not sure yet</option>
        </select>
      </div>
      <div>
        <label for="message" class="block text-sm font-medium text-navy">Message</label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="mt-1.5 w-full rounded-lg border border-border bg-cream px-3 py-2.5 text-navy placeholder:text-navy/35 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          placeholder="A bit about where you are and what you’re figuring out…"
        ></textarea>
      </div>
      <div id="intent-slot"></div>
      <button id="contact-submit" type="submit" class="btn-primary w-full sm:w-auto">
        Send message
      </button>
      <p class="text-xs leading-relaxed text-navy/50">
        No spam. Messages go to the team at Beers Podcast — educational conversation only, not
        financial advice or earnings claims.
      </p>
    </form>
  </section>

  <script define:vars={{ contactEndpoint }}>
    const INTEREST_LABELS = {
      guide: 'The Copy-Paste Millionaire free guide',
      buy: 'Buying a business',
      grow: 'Growing my business',
      unsure: 'Not sure yet',
    };

    const params = new URLSearchParams(window.location.search);
    const email = params.get('email') || '';
    const isGuide = params.get('intent') === 'guide';

    const emailInput = document.getElementById('email');
    const interest = document.getElementById('interest');
    const message = document.getElementById('message');
    const heading = document.getElementById('contact-heading');
    const lead = document.getElementById('contact-lead');
    const submit = document.getElementById('contact-submit');
    const intentSlot = document.getElementById('intent-slot');
    const form = document.getElementById('contact-form');
    const successEl = document.getElementById('contact-success');
    const successDetail = document.getElementById('contact-success-detail');
    const errorEl = document.getElementById('contact-error');

    const defaultSubmitLabel = submit?.textContent || 'Send message';

    if (email && emailInput instanceof HTMLInputElement) {
      emailInput.value = email;
    }

    if (isGuide) {
      if (heading) heading.textContent = 'Get the free guide';
      if (lead) {
        lead.textContent =
          'Leave your details for The Copy-Paste Millionaire free guide. We’ll follow up with delivery details.';
      }
      if (interest instanceof HTMLSelectElement) interest.value = 'guide';
      if (message instanceof HTMLTextAreaElement && !message.value) {
        message.value = 'Please send The Copy-Paste Millionaire free guide when it is ready.';
      }
      if (submit) submit.textContent = 'Request the guide';
      if (intentSlot) {
        intentSlot.innerHTML = '<input type="hidden" name="intent" value="guide" />';
      }
      if (successDetail) {
        successDetail.textContent =
          'Thanks for requesting the free guide. We’ll follow up with delivery details soon.';
      }
    }

    function setLoading(loading) {
      if (!(submit instanceof HTMLButtonElement)) return;
      submit.disabled = loading;
      submit.classList.toggle('opacity-70', loading);
      submit.classList.toggle('cursor-wait', loading);
      if (loading) {
        submit.textContent = 'Sending…';
      } else {
        submit.textContent = isGuide ? 'Request the guide' : defaultSubmitLabel;
      }
    }

    function showError(visible) {
      if (!errorEl) return;
      errorEl.classList.toggle('hidden', !visible);
    }

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      showError(false);

      if (!(form instanceof HTMLFormElement)) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const fd = new FormData(form);
      const interestValue = String(fd.get('interest') || 'unsure');
      const intentValue = String(fd.get('intent') || (isGuide ? 'guide' : ''));
      const interestLabel = INTEREST_LABELS[interestValue] || interestValue;

      let subject = `[brianbeers.com] Contact — ${interestLabel}`;
      if (intentValue === 'guide' || interestValue === 'guide') {
        subject = `[brianbeers.com] Free guide request — ${interestLabel}`;
      }

      const payload = {
        name: String(fd.get('name') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        interest: interestValue,
        interest_label: interestLabel,
        message: String(fd.get('message') || '').trim(),
        page: window.location.href,
        _cc: 'brian@beerspodcast.com',
        _subject: subject,
        _template: 'table',
        _captcha: 'false',
        _honey: String(fd.get('_honey') || ''),
      };

      if (intentValue) {
        payload.intent = intentValue;
      }

      setLoading(true);
      try {
        const res = await fetch(contactEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
        });

        let data = null;
        try {
          data = await res.json();
        } catch {
          data = null;
        }

        const ok =
          res.ok &&
          (data == null ||
            data.success !== false &&
              data.success !== 'false' &&
              !String(data.message || '').toLowerCase().includes('error'));

        if (!ok) {
          throw new Error((data && (data.message || data.error)) || `HTTP ${res.status}`);
        }

        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
        form.reset();
        if (isGuide && intentSlot) {
          intentSlot.innerHTML = '<input type="hidden" name="intent" value="guide" />';
        }
      } catch {
        showError(true);
      } finally {
        setLoading(false);
      }
    });
  </script>
</BaseLayout>
