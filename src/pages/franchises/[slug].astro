---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('franchises');
  return pages
    .filter((p) => p.data.publish && (p.data.status === 'ready' || p.data.status === 'published'))
    .map((page) => {
      const slug = page.data.slug ?? page.id.replace(/\.(md|mdx|mdoc)$/, '');
      return { params: { slug }, props: { page } };
    });
}

const { page } = Astro.props;
const { Content } = await render(page);
const slug = page.data.slug ?? page.id.replace(/\.(md|mdx|mdoc)$/, '');
---
<BaseLayout title={`${page.data.title} — Brian Beers`} description={page.data.description}>
  <article class="section">
    <nav class="text-sm text-navy/50" aria-label="Breadcrumb">
      <a href="/buy" class="font-medium hover:text-accent">Buy</a>
      <span class="mx-2">/</span>
      <a href="/franchises" class="font-medium hover:text-accent">Franchises</a>
      <span class="mx-2">/</span>
      <span class="text-navy/70">{page.data.title}</span>
    </nav>
    <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-accent">Buy · Franchises · Guide</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-navy">{page.data.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-navy/75">{page.data.description}</p>
    <div class="mt-6 flex flex-wrap gap-3 text-sm text-navy/60">
      <span class="rounded-full border border-border bg-white px-3 py-1 shadow-sm">
        {page.data.readMinutes} min read
      </span>
      {page.data.tags?.map((tag) => (
        <span class="rounded-full border border-border bg-white px-3 py-1 shadow-sm">{tag}</span>
      ))}
    </div>
    <div class="prose-bb mt-10 space-y-4 text-navy/80 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-navy [&_h3]:mt-6 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-navy [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_table]:w-full [&_table]:text-sm [&_td]:border [&_td]:border-border [&_td]:p-2 [&_th]:border [&_th]:border-border [&_th]:p-2 [&_th]:text-left [&_a]:font-semibold [&_a]:text-accent [&_a]:hover:text-accent-hover">
      <Content />
    </div>
    <div class="mt-12 rounded-2xl border border-border bg-slate-50/80 p-8 text-center shadow-sm">
      <p class="text-lg font-semibold text-navy">Want help thinking this through?</p>
      <p class="mt-2 text-sm text-navy/60">Soft CTA — educational conversation on fit, capital, and process. No pressure.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn-primary">Contact Brian</a>
        <a href="/franchises" class="btn-secondary">Back to franchise hub</a>
      </div>
    </div>
  </article>
</BaseLayout>
