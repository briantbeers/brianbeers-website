---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const models = await getCollection('models');
  return models.map((model) => {
    const slug = model.data.slug ?? model.id.replace(/\.(md|mdx|mdoc)$/, '');
    return {
      params: { slug },
      props: { model },
    };
  });
}

const { model } = Astro.props;
const { Content } = await render(model);

const categoryLabel: Record<string, string> = {
  'home-services': 'Home services',
  'senior-care': 'Senior care',
  'retail-resale': 'Retail / resale',
  auto: 'Auto',
  'food-hospitality': 'Food / hospitality',
  'business-services': 'Business services',
  'health-wellness': 'Health / wellness',
  'real-estate-ops': 'Real estate ops',
  education: 'Education',
  other: 'Other',
};

function youtubeIdFromUrl(url?: string): string | null {
  if (!url) return null;
  try {
    const u = new URL(url);
    if (u.hostname.includes('youtu.be')) {
      return u.pathname.replace(/^\//, '').split('/')[0] || null;
    }
    if (u.hostname.includes('youtube.com')) {
      return u.searchParams.get('v');
    }
  } catch {
    return null;
  }
  return null;
}

const youtubeSources = (model.data.sources ?? []).filter((s) => s.type === 'youtube' && s.url);
const primaryYoutube = youtubeSources[0];
const youtubeId = youtubeIdFromUrl(primaryYoutube?.url);
---
<BaseLayout title={`${model.data.title} — Brian Beers`} description={model.data.description}>
  <article class="section">
    <a href="/models" class="text-sm font-semibold text-navy/60 hover:text-accent">← All models</a>
    <p class="mt-6 text-sm font-semibold uppercase tracking-wider text-accent">
      {categoryLabel[model.data.category] ?? model.data.category}
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-navy">{model.data.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-navy/75">{model.data.description}</p>
    <div class="mt-6 flex flex-wrap gap-3 text-sm text-navy/60">
      <span class="rounded-full border border-border bg-white px-3 py-1 shadow-sm">
        {model.data.readMinutes} min read
      </span>
      {model.data.tags?.map((tag) => (
        <span class="rounded-full border border-border bg-white px-3 py-1 shadow-sm">{tag}</span>
      ))}
    </div>

    {youtubeId && (
      <div class="mt-10 overflow-hidden rounded-2xl border border-border bg-black shadow-sm ring-1 ring-border">
        <div class="relative aspect-video w-full">
          <iframe
            class="absolute inset-0 h-full w-full"
            src={`https://www.youtube.com/embed/${youtubeId}`}
            title={primaryYoutube?.title ?? 'YouTube video'}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          />
        </div>
        {primaryYoutube?.title && (
          <p class="border-t border-border bg-[#f9f8f4] px-4 py-3 text-sm text-navy/70">
            {primaryYoutube.title}
          </p>
        )}
      </div>
    )}

    <div class="prose-bb mt-10 space-y-4 text-navy/80 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-navy [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-5 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_a]:font-semibold [&_a]:text-accent [&_a]:hover:text-accent-hover [&_img]:my-8 [&_img]:w-full [&_img]:rounded-2xl [&_img]:shadow-sm [&_img]:ring-1 [&_img]:ring-border [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-navy [&_strong]:text-navy">
      <Content />
    </div>
    <div class="mt-12 rounded-2xl border border-border bg-[#f9f8f4] p-8 text-center shadow-sm">
      <p class="text-lg font-semibold text-navy">Want help thinking this through?</p>
      <p class="mt-2 text-sm text-navy/60">Soft CTA — educational conversation, no pressure.</p>
      <a href="/contact" class="btn-primary mt-5">Contact Brian</a>
    </div>
  </article>
</BaseLayout>
