---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function isLive(data: { publish: boolean; status: string }) {
  return data.publish && (data.status === 'ready' || data.status === 'published');
}

function modelPath(model: { data: { slug?: string }; id: string }) {
  return model.data.slug ?? model.id.replace(/\.(md|mdx|mdoc)$/, '');
}

function articlePath(article: { data: { slug?: string }; id: string }) {
  return article.data.slug ?? article.id.replace(/\.(md|mdx|mdoc)$/, '');
}

const models = (await getCollection('models')).filter((entry) => isLive(entry.data));
const articles = (await getCollection('articles')).filter((entry) => isLive(entry.data));

type FeatureCard = {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  cta: string;
};

const categoryLabel: Record<string, string> = {
  'home-services': 'Home services',
  'senior-care': 'Senior care',
  'retail-resale': 'Retail / resale',
  auto: 'Auto',
  'food-hospitality': 'Food / hospitality',
  'business-services': 'Business services',
  'health-wellness': 'Health / wellness',
  'real-estate-ops': 'Real estate ops',
  education: 'Education',
  other: 'Other',
};

const kindLabel: Record<string, string> = {
  article: 'Article',
  guide: 'Guide',
};

const featuredModels = models
  .filter((m) => m.data.doors?.includes('buy'))
  .map(
    (m): FeatureCard => ({
      href: `/models/${modelPath(m)}`,
      eyebrow: categoryLabel[m.data.category] ?? m.data.category,
      title: m.data.title,
      description: m.data.description,
      cta: 'Read guide →',
    })
  );

const featuredArticles = articles
  .filter((a) => a.data.doors?.includes('buy'))
  .map(
    (a): FeatureCard => ({
      href: `/articles/${articlePath(a)}`,
      eyebrow: kindLabel[a.data.kind] ?? a.data.kind,
      title: a.data.title,
      description: a.data.description,
      cta: 'Read →',
    })
  );

const featured = [...featuredArticles, ...featuredModels]
  .sort((a, b) => a.title.localeCompare(b.title))
  .slice(0, 3);

// Fallback: if no doors set yet, show up to 3 published models
const cards: FeatureCard[] =
  featured.length > 0
    ? featured
    : models
        .sort((a, b) => a.data.title.localeCompare(b.data.title))
        .slice(0, 3)
        .map((m) => ({
          href: `/models/${modelPath(m)}`,
          eyebrow: categoryLabel[m.data.category] ?? m.data.category,
          title: m.data.title,
          description: m.data.description,
              cta: 'Read guide →',
        }));
---
<BaseLayout
  title="Buy a business — Brian Beers"
  description="Explore business models and franchises with calm, practical guidance — soft ownership path, no hype."
>
  <section class="section !pb-8">
    <h1 class="text-4xl font-bold tracking-tight text-navy sm:text-5xl">Buy a business</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy/75">
      Choosing a vehicle is less about hype and more about fit: capital, lifestyle, skills, and the kind of
      work you want to own. Browse sample models below, or explore franchises as another path under this journey.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/models" class="btn-primary">Browse models</a>
      <a href="/articles" class="btn-secondary">Articles & guides</a>
      <a href="/franchises" class="btn-secondary">Franchise hub</a>
      <a href="/contact" class="btn-secondary">Ask a question</a>
    </div>
  </section>

  <section class="section !pt-4 !pb-8">
    <div class="mb-6 flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-navy">Featured for Buy</h2>
        <p class="mt-1 text-sm text-navy/60">Models and guides tagged for this path — educational only.</p>
      </div>
      <a href="/models" class="hidden text-sm font-semibold text-navy hover:text-accent sm:inline">View models →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <a href={card.href} class="card group block transition hover:border-accent/40 hover:shadow-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-navy/50">{card.eyebrow}</p>
          <h3 class="mt-2 text-xl font-bold text-navy group-hover:text-navy-soft">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-navy/70">{card.description}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-accent">{card.cta}</span>
        </a>
      ))}
    </div>
    <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
      <a href="/models" class="text-navy hover:text-accent sm:hidden">View all models →</a>
      <a href="/articles" class="text-navy hover:text-accent">More articles →</a>
    </div>
  </section>

  <section class="border-y border-border bg-slate-50/50">
    <div class="section max-w-3xl">
      <h2 class="text-2xl font-bold text-navy">Also under Buy: franchises</h2>
      <p class="mt-3 leading-relaxed text-navy/70">
        Franchising is one vehicle among many — useful when brand systems, training, and territory rules
        match your goals. Compare it against independent models before you commit.
      </p>
      <a href="/franchises" class="btn-secondary mt-6">Explore the franchise hub</a>
    </div>
  </section>

  <section class="section text-center">
    <h2 class="text-2xl font-bold text-navy">Not sure where to start?</h2>
    <p class="mx-auto mt-3 max-w-xl text-navy/65">
      A short conversation can help you narrow options without a hard pitch.
    </p>
    <a href="/contact" class="btn-primary mt-6">Ask a question</a>
  </section>
</BaseLayout>
