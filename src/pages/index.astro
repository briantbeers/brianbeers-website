---
import BaseLayout from '../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

const photoPath = path.join(process.cwd(), 'public', 'brian-photo-ref.jpg');
const hasPhoto = fs.existsSync(photoPath);
const bookPath = path.join(process.cwd(), 'public', 'free-guide-book.png');
const hasBook = fs.existsSync(bookPath);
---
<BaseLayout
  title="Brian Beers — Own the outcome. Find the right vehicle."
  description="Clear guidance for buying or growing a business — soft ownership path, no hype."
>
  <!-- James Clear–style hero: cream top / white bottom, book straddles the split -->
  <section class="relative overflow-hidden">
    <!-- Cream top half: lighter near nav → darker toward center/book -->
    <div
      class="pt-14 pb-28 sm:pt-16 sm:pb-36"
      style="background: linear-gradient(180deg, #f9f8f4 0%, #f9f8f4 100%);"
    >
      <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
        <h1 class="text-4xl font-bold tracking-tight text-navy sm:text-5xl sm:leading-[1.12]">
          Own the outcome.<br class="hidden sm:block" /> Find the right vehicle.
        </h1>
      </div>
    </div>

    <!-- Book sits on the cream/white seam -->
    <div class="relative z-10 -mt-24 flex justify-center px-4 sm:-mt-28">
      {hasBook ? (
        <img
          src="/free-guide-book.png"
          alt="The Copy-Paste Millionaire — free guide by Brian Beers"
          class="h-auto w-[220px] drop-shadow-xl sm:w-[280px] md:w-[320px]"
          width="721"
          height="992"
        />
      ) : (
        <div class="flex h-72 w-48 items-center justify-center rounded bg-cream-deep text-sm text-navy/50">
          Book image
        </div>
      )}
    </div>

    <!-- White bottom: lead magnet under the book -->
    <div class="bg-white pb-16 pt-8 sm:pb-20 sm:pt-10">
      <div class="mx-auto max-w-xl px-4 text-center sm:px-6">
        <p class="text-base font-medium text-navy sm:text-lg">
          Download my free guide on how ordinary people build extraordinary businesses by scaling proven business models
        </p>
        <p class="mt-2 text-sm text-navy/55">
          Free guide — practical frameworks for choosing and scaling a proven model. Educational only, no earnings promises.
        </p>
        <form action="/contact" method="get" class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row sm:items-stretch">
          <label class="sr-only" for="hero-email">Email</label>
          <input
            id="hero-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="Email address"
            class="w-full flex-1 rounded-md border border-border bg-white px-4 py-2.5 text-sm text-navy placeholder:text-navy/40 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/40"
          />
          <input type="hidden" name="intent" value="guide" />
          <button type="submit" class="btn-primary whitespace-nowrap sm:px-6">
            Get the free guide
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Hi I'm Brian + photo -->
  <section class="border-y border-border bg-cream-soft">
    <div class="section !py-16 sm:!py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
        <div class="order-2 lg:order-1">
          <p class="text-sm font-semibold uppercase tracking-wider text-navy/45">About</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-navy sm:text-4xl">Hi, I’m Brian</h2>
          <p class="mt-5 text-lg leading-relaxed text-navy/75">
            I help people cut through the noise around ownership — so you can choose a business path that fits
            your life, capital, and operating style.
          </p>
          <p class="mt-4 leading-relaxed text-navy/70">
            No highlight-reel hype. Just clearer framing for buying, franchising, or growing what you already run.
          </p>
          <a href="/about" class="btn-secondary mt-7">More about Brian</a>
        </div>
        <div class="order-1 flex justify-center lg:order-2 lg:justify-end">
          {hasPhoto ? (
            <img
              src="/brian-photo-ref.jpg"
              alt="Brian Beers"
              class="h-72 w-72 rounded-3xl object-cover shadow-lg ring-1 ring-border sm:h-80 sm:w-80"
              width="320"
              height="320"
            />
          ) : (
            <div class="flex h-72 w-72 items-center justify-center rounded-3xl bg-cream-deep text-navy/40 ring-1 ring-border sm:h-80 sm:w-80">
              Photo placeholder
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Buy / Grow -->
  <section class="section !py-16 sm:!py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-navy">Where do you want to go?</h2>
      <p class="mt-3 text-navy/65">Two doors. Same library of models and ideas — different starting point.</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <a href="/buy" class="group overflow-hidden rounded-2xl border border-border bg-white shadow-sm transition hover:border-accent/50 hover:shadow-md">
        <div class="relative flex h-44 items-end bg-cream p-6 sm:h-52">
          <div class="absolute inset-0 opacity-50" style="background-image: radial-gradient(circle at 18% 30%, #FBA91A44 0%, transparent 42%);"></div>
          <p class="relative text-xs font-semibold uppercase tracking-wider text-navy/50">Door 1</p>
        </div>
        <div class="p-6">
          <h3 class="text-2xl font-bold text-navy group-hover:text-navy-soft">Buy a business</h3>
          <p class="mt-3 text-navy/70">
            Explore models and franchises with a practical path to choosing a vehicle that matches your life —
            not someone else’s highlight reel.
          </p>
          <span class="mt-5 inline-block text-sm font-semibold text-navy group-hover:text-accent">Explore Buy →</span>
        </div>
      </a>

      <a href="/grow" class="group overflow-hidden rounded-2xl border border-border bg-white shadow-sm transition hover:border-accent/50 hover:shadow-md">
        <div class="relative flex h-44 items-end bg-cream-deep p-6 sm:h-52">
          <div class="absolute inset-0 opacity-50" style="background-image: radial-gradient(circle at 80% 25%, #FBA91A44 0%, transparent 40%);"></div>
          <p class="relative text-xs font-semibold uppercase tracking-wider text-navy/50">Door 2</p>
        </div>
        <div class="p-6">
          <h3 class="text-2xl font-bold text-navy group-hover:text-navy-soft">Grow your business</h3>
          <p class="mt-3 text-navy/70">
            Owner vs operator tradeoffs, freedom design, and the systems that help you scale without losing the plot.
          </p>
          <span class="mt-5 inline-block text-sm font-semibold text-navy group-hover:text-accent">Explore Grow →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="section !py-14 text-center">
      <h2 class="text-2xl font-bold text-navy sm:text-3xl">Prefer to talk it through?</h2>
      <p class="mx-auto mt-3 max-w-xl text-navy/60">
        Soft CTA only — share where you are and we’ll go from there. No pitch deck dump.
      </p>
      <a href="/contact" class="btn-primary mt-8">Contact Brian</a>
    </div>
  </section>
</BaseLayout>
