---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function isLive(data: { publish: boolean; status: string }) {
  return data.publish && (data.status === 'ready' || data.status === 'published');
}

function modelPath(model: { data: { slug?: string }; id: string }) {
  return model.data.slug ?? model.id.replace(/\.(md|mdx|mdoc)$/, '');
}

function articlePath(article: { data: { slug?: string }; id: string }) {
  return article.data.slug ?? article.id.replace(/\.(md|mdx|mdoc)$/, '');
}

const models = (await getCollection('models')).filter((entry) => isLive(entry.data));
const articles = (await getCollection('articles')).filter((entry) => isLive(entry.data));

type FeatureCard = {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  readMinutes: number;
  cta: string;
};

const categoryLabel: Record<string, string> = {
  'home-services': 'Home services',
  'senior-care': 'Senior care',
  'retail-resale': 'Retail / resale',
  auto: 'Auto',
  'food-hospitality': 'Food / hospitality',
  'business-services': 'Business services',
  'health-wellness': 'Health / wellness',
  'real-estate-ops': 'Real estate ops',
  education: 'Education',
  other: 'Other',
};

const kindLabel: Record<string, string> = {
  article: 'Article',
  guide: 'Guide',
};

const featuredModels = models
  .filter((m) => m.data.doors?.includes('grow'))
  .map(
    (m): FeatureCard => ({
      href: `/models/${modelPath(m)}`,
      eyebrow: categoryLabel[m.data.category] ?? m.data.category,
      title: m.data.title,
      description: m.data.description,
      readMinutes: m.data.readMinutes,
      cta: 'Read guide →',
    })
  );

const featuredArticles = articles
  .filter((a) => a.data.doors?.includes('grow'))
  .map(
    (a): FeatureCard => ({
      href: `/articles/${articlePath(a)}`,
      eyebrow: kindLabel[a.data.kind] ?? a.data.kind,
      title: a.data.title,
      description: a.data.description,
      readMinutes: a.data.readMinutes,
      cta: 'Read →',
    })
  );

const featured = [...featuredArticles, ...featuredModels]
  .sort((a, b) => a.title.localeCompare(b.title))
  .slice(0, 3);
---
<BaseLayout
  title="Grow your business — Brian Beers"
  description="Owner vs operator tradeoffs, freedom design, and systems that help you scale without losing the plot."
>
  <section class="section !pb-8">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Grow</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-navy sm:text-5xl">Grow your business</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy/75">
      Growth is not just “more revenue.” It’s designing the role you want — owner, operator, or a deliberate
      mix — and building systems that create freedom instead of another job.
    </p>
  </section>

  <section class="section !pt-4">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="card">
        <p class="text-xs font-semibold uppercase tracking-wider text-navy/45">Path A</p>
        <h2 class="mt-2 text-xl font-bold text-navy">Owner path</h2>
        <p class="mt-3 leading-relaxed text-navy/70">
          Focus on vision, capital allocation, leadership, and the scoreboard. You spend less time in the
          weeds and more time on decisions that compound.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-navy/70">
          <li>Clarify what only you should own</li>
          <li>Hire / promote for operating excellence</li>
          <li>Protect calendar for strategy and relationships</li>
        </ul>
      </div>
      <div class="card">
        <p class="text-xs font-semibold uppercase tracking-wider text-navy/45">Path B</p>
        <h2 class="mt-2 text-xl font-bold text-navy">Operator path</h2>
        <p class="mt-3 leading-relaxed text-navy/70">
          Stay close to delivery, customers, and quality. Growth still matters — but the craft and control
          of the work remain central to how you win.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-navy/70">
          <li>Define capacity before chasing volume</li>
          <li>Productize recurring services</li>
          <li>Build simple SOPs so quality scales with you</li>
        </ul>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section !pt-4 !pb-8">
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-navy">Featured for Grow</h2>
          <p class="mt-1 text-sm text-navy/60">Articles and models tagged for this path — educational only.</p>
        </div>
        <a href="/articles" class="hidden text-sm font-semibold text-navy hover:text-accent sm:inline">Articles →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((card) => (
          <a href={card.href} class="card group block transition hover:border-accent/40 hover:shadow-md">
            <p class="text-xs font-semibold uppercase tracking-wider text-navy/50">{card.eyebrow}</p>
            <h3 class="mt-2 text-xl font-bold text-navy group-hover:text-navy-soft">{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy/70">{card.description}</p>
            <p class="mt-4 text-xs text-navy/55">{card.readMinutes} min read</p>
            <span class="mt-4 inline-block text-sm font-semibold text-accent">{card.cta}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="border-y border-border bg-slate-50/50">
    <div class="section max-w-3xl">
      <h2 class="text-2xl font-bold text-navy">Freedom design</h2>
      <p class="mt-4 leading-relaxed text-navy/75">
        Freedom is a design constraint: time off, location flexibility, team dependency, and cash
        predictability. Name the freedom you want, then reverse-engineer the operating model. Educational
        framing — customize in conversation.
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="font-semibold text-navy">Time</p>
          <p class="mt-1 text-sm text-navy/65">What does a good week look like?</p>
        </div>
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="font-semibold text-navy">Team</p>
          <p class="mt-1 text-sm text-navy/65">Who must you trust for the business to run?</p>
        </div>
        <div class="rounded-xl border border-border bg-white p-5 shadow-sm">
          <p class="font-semibold text-navy">Cash</p>
          <p class="mt-1 text-sm text-navy/65">What rhythm of revenue feels stable?</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section text-center">
    <h2 class="text-2xl font-bold text-navy">Want a sounding board?</h2>
    <p class="mx-auto mt-3 max-w-xl text-navy/65">
      Share where you are stuck — systems, people, or positioning — and we’ll talk options. Soft CTA only.
    </p>
    <a href="/contact" class="btn-primary mt-6">Contact Brian</a>
  </section>
</BaseLayout>
