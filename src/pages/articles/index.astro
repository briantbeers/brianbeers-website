---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter((a) => a.data.publish && (a.data.status === 'ready' || a.data.status === 'published'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

function articlePath(article: (typeof articles)[number]) {
  return article.data.slug ?? article.id.replace(/\.(md|mdx|mdoc)$/, '');
}

const kindLabel: Record<string, string> = {
  article: 'Article',
  guide: 'Guide',
};
---
<BaseLayout
  title="Articles & guides — Brian Beers"
  description="Educational articles and guides on buying and growing a business — calm structure, soft CTAs, no earnings claims."
>
  <section class="section">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Learn</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-navy sm:text-5xl">Articles & guides</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy/75">
      Short educational pieces on ownership paths, roles, and how to think about fit. Not offers — clear
      framing so you can decide what to explore next.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {articles.map((article) => (
        <a href={`/articles/${articlePath(article)}`} class="card group block transition hover:border-accent/40 hover:shadow-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-navy/50">
            {kindLabel[article.data.kind] ?? article.data.kind}
          </p>
          <h2 class="mt-2 text-xl font-bold text-navy group-hover:text-navy-soft">{article.data.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-navy/70">{article.data.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {article.data.tags?.slice(0, 4).map((tag) => (
              <span class="rounded-full border border-border bg-white px-2.5 py-0.5 text-xs text-navy/55">{tag}</span>
            ))}
          </div>
          <span class="mt-4 inline-block text-sm font-semibold text-accent">Read →</span>
        </a>
      ))}
    </div>

    {articles.length === 0 && (
      <p class="mt-10 text-navy/60">No published articles yet. Check back soon.</p>
    )}

    <div class="mt-12 rounded-2xl border border-border bg-slate-50/60 p-6 sm:p-8">
      <p class="text-sm font-semibold text-navy">Also explore</p>
      <p class="mt-2 text-sm leading-relaxed text-navy/65">
        Browse
        <a href="/models" class="font-semibold text-navy hover:text-accent">business models</a>,
        start on
        <a href="/buy" class="font-semibold text-navy hover:text-accent">Buy</a>,
        or design growth on
        <a href="/grow" class="font-semibold text-navy hover:text-accent">Grow</a>.
      </p>
    </div>
  </section>
</BaseLayout>
